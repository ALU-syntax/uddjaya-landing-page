<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pendaftaran customer B2B Budiman Roastery">
    <meta name="theme-color" content="#911b1d">
    <meta property="og:title" content="Pendaftaran Customer B2B Budiman Roastery">
    <meta property="og:description" content="Daftarkan usaha Anda sebagai customer B2B Budiman Roastery">
    <meta property="og:type" content="website">

    <link rel="icon" href="/img/b2b/budiman-logogram-white.png" type="image/png">
    <link rel="stylesheet" href="/css/vendor/normalize.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css">
    <link rel="stylesheet" href="/vendor/izitoast/css/iziToast.min.css">
    <link rel="stylesheet" href="/css/b2b-register.css">

    <title><%= title %> | Budiman Roastery</title>
</head>

<body>
    <main class="b2b-page">
        <section class="b2b-shell" aria-labelledby="b2b-title">
            <aside class="b2b-brand">
                <img class="b2b-brand__logo" src="/img/b2b/budiman-logogram-white.png" alt="">
                <div>
                    <p class="b2b-brand__name">Budiman Roastery</p>
                    <h1 id="b2b-title" class="b2b-brand__title"><%= title %></h1>
                    <p class="b2b-brand__text">Daftarkan usaha Anda untuk pemesanan kopi dalam jumlah besar. Data ini dipakai untuk pesanan, invoice, dan pengingat tagihan.</p>
                </div>
                <ul class="b2b-brand__steps">
                    <li><span>1</span>Isi data usaha &amp; kontak</li>
                    <li><span>2</span>Tambahkan alamat &amp; rekening (opsional)</li>
                    <li><span>3</span>Tim kami akan menghubungi Anda</li>
                </ul>
            </aside>

            <form id="b2b-register-form" class="b2b-form" action="/b2b/register" method="post" novalidate>
                <fieldset class="b2b-section">
                    <legend class="b2b-section__title">Data usaha</legend>

                    <div class="form-field form-field--full">
                        <span class="form-label">Jenis usaha <span class="required-mark">*</span></span>
                        <div class="b2b-choice" role="radiogroup" aria-label="Jenis usaha">
                            <% Object.entries(customerTypes).forEach(([value, label], index) => { %>
                                <label class="b2b-choice__item">
                                    <input type="radio" name="type" value="<%= value %>" <%= index === 1 ? 'checked' : '' %> required>
                                    <span><%= label %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="form-field form-field--full">
                        <label for="name"><span data-type-label>Nama usaha</span> <span class="required-mark">*</span></label>
                        <input id="name" name="name" type="text" maxlength="255" autocomplete="organization" placeholder="PT Kopi Nusantara" required>
                        <small class="field-help" data-type-help>Tulis lengkap dengan PT/CV seperti di dokumen resmi.</small>
                    </div>

                    <div class="form-field form-field--full">
                        <label for="npwp">NPWP</label>
                        <input id="npwp" name="npwp" type="text" maxlength="30" inputmode="numeric" autocomplete="off" placeholder="Opsional">
                    </div>
                </fieldset>

                <fieldset class="b2b-section">
                    <legend class="b2b-section__title">Kontak penanggung jawab</legend>

                    <div class="form-field">
                        <label for="contact_name">Nama PIC <span class="required-mark">*</span></label>
                        <input id="contact_name" name="contact_name" type="text" maxlength="255" autocomplete="name" placeholder="Budi Santoso" required>
                        <label class="b2b-check" data-pic-same hidden>
                            <input id="pic_same" type="checkbox">
                            <span>PIC sama dengan nama lengkap</span>
                        </label>
                    </div>

                    <div class="form-field">
                        <label for="phone">Telepon / WhatsApp <span class="required-mark">*</span></label>
                        <input id="phone" class="js-digits-only" name="phone" type="text" inputmode="numeric" maxlength="15"
                            pattern="08[0-9]{8,13}" autocomplete="tel" placeholder="081234567890" required>
                    </div>

                    <div class="form-field form-field--full">
                        <label for="email">Email</label>
                        <input id="email" name="email" type="email" maxlength="255" autocomplete="email" placeholder="finance@perusahaan.co.id">
                        <small class="field-help">Untuk menerima invoice dan pengingat tagihan.</small>
                    </div>
                </fieldset>

                <fieldset class="b2b-section">
                    <legend class="b2b-section__title">Alamat <span class="b2b-section__hint">opsional</span></legend>

                    <div class="form-field form-field--full">
                        <label for="address">Alamat lengkap</label>
                        <textarea id="address" name="address" rows="2" maxlength="1000" autocomplete="street-address" placeholder="Nama jalan, nomor, RT/RW, patokan"></textarea>
                        <small class="field-help">Dipakai sebagai alamat penagihan sekaligus pengiriman.</small>
                    </div>

                    <div class="form-field">
                        <label for="province_code">Provinsi</label>
                        <select id="province_code" name="province_code" class="js-region" data-placeholder="Pilih provinsi">
                            <option value=""></option>
                            <% (provinces || []).forEach((province) => { %>
                                <option value="<%= province.code %>"><%= province.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="regency_code">Kota / Kabupaten</label>
                        <select id="regency_code" name="regency_code" class="js-region" data-level="regencies" data-placeholder="Pilih kota/kabupaten" disabled>
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="district_code">Kecamatan</label>
                        <select id="district_code" name="district_code" class="js-region" data-level="districts" data-placeholder="Pilih kecamatan" disabled>
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="village_code">Kelurahan / Desa</label>
                        <select id="village_code" name="village_code" class="js-region" data-level="villages" data-placeholder="Pilih kelurahan/desa" disabled>
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="postal_code">Kode pos</label>
                        <input id="postal_code" class="js-digits-only" name="postal_code" type="text" inputmode="numeric" maxlength="10" autocomplete="postal-code" placeholder="Terisi otomatis">
                    </div>
                </fieldset>

                <fieldset class="b2b-section">
                    <legend class="b2b-section__title">Rekening pengirim <span class="b2b-section__hint">opsional</span></legend>
                    <p class="b2b-section__desc form-field--full">Rekening bank atau e-wallet yang biasa Anda pakai untuk mentransfer pembayaran, supaya pembayaran mudah kami cocokkan.</p>

                    <div id="account-rows" class="b2b-accounts form-field--full" data-max="<%= maxAccounts %>"></div>
                    <button id="account-add" class="b2b-link-button form-field--full" type="button">+ Tambah rekening</button>
                </fieldset>

                <% if (turnstileSiteKey) { %>
                    <div class="form-field form-field--full turnstile-field">
                        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-action="b2b-register" data-theme="light"></div>
                    </div>
                <% } %>

                <button class="b2b-submit" type="submit">Daftar</button>
                <p class="b2b-note">Dengan mendaftar, Anda menyetujui data ini disimpan untuk keperluan transaksi dengan Budiman Roastery.</p>
            </form>

            <section id="b2b-success" class="b2b-success" hidden aria-live="polite">
                <div class="b2b-success__icon" aria-hidden="true">&#10003;</div>
                <h2 class="b2b-success__title">Pendaftaran berhasil</h2>
                <p class="b2b-success__text">Terima kasih, <strong data-success-name></strong>. Data usaha Anda sudah kami terima.</p>
                <div class="b2b-success__notice" data-success-notice hidden>
                    <p class="b2b-success__text">Konfirmasi pendaftaran beserta nomor admin untuk pemesanan akan kami kirim dalam beberapa menit ke:</p>
                    <ul class="b2b-success__contacts" data-success-contacts></ul>
                </div>
            </section>
        </section>
    </main>

    <template id="account-row-template">
        <div class="b2b-account">
            <div class="form-field">
                <label>Bank / e-wallet</label>
                <select data-field="provider" class="js-provider" data-placeholder="Pilih" required>
                    <option value=""></option>
                    <% providerGroups.forEach((group) => { %>
                        <optgroup label="<%= group.label %>">
                            <% group.options.forEach((option) => { %>
                                <option value="<%= option.code %>"><%= option.name %></option>
                            <% }) %>
                        </optgroup>
                    <% }) %>
                </select>
            </div>
            <div class="form-field">
                <label>Nomor rekening</label>
                <input data-field="account_number" class="js-digits-only" type="text" inputmode="numeric" maxlength="20" placeholder="1234567890" required>
            </div>
            <div class="form-field">
                <label>Nama pemilik</label>
                <input data-field="account_name" type="text" maxlength="255" placeholder="Sesuai buku tabungan" required>
            </div>
            <button class="b2b-account__remove" type="button" aria-label="Hapus rekening">&times;</button>
        </div>
    </template>

    <script id="b2b-config" type="application/json"><%- JSON.stringify({ ewalletProviders: ewalletProviderCodes }) %></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js" defer></script>
    <% if (turnstileSiteKey) { %>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
    <script src="/vendor/izitoast/js/iziToast.min.js" defer></script>
    <script src="/js/b2b-register.js" defer></script>
</body>

</html>
